#!/usr/sbin/nft -f

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop

        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

        # Administrative SSH is accepted only from the Proxmox host.
        ip saddr 192.168.1.5 tcp dport 22 ct state new accept

        # Application ingress is accepted only from the internal Nginx proxy.
        ip saddr 192.168.1.4 tcp dport 4100 ct state new accept

        # Operational metrics are accepted only from the Prometheus collector.
        ip saddr 192.168.1.24 tcp dport 9100 ct state new accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
