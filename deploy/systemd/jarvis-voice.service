[Unit]
Description=JARVIS private speech recognition and synthesis service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis-voice
Group=jarvis-voice
EnvironmentFile=/etc/jarvis-voice/environment
ExecStart=/opt/jarvis-voice/venv/bin/python /opt/jarvis-voice/jarvis_voice.py
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
