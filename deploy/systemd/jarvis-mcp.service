[Unit]
Description=JARVIS private MCP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis-mcp
Group=jarvis-mcp
EnvironmentFile=/etc/jarvis-mcp/environment
ExecStart=/usr/bin/python3 /opt/jarvis-mcp/jarvis_mcp.py
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
