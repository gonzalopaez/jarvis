JARVIS_VOICE_BIND=192.168.1.22:4200
JARVIS_WHISPER_MODEL=/opt/jarvis-voice/models/faster-whisper-small
JARVIS_WHISPER_THREADS=4
JARVIS_PIPER_MODEL=/opt/jarvis-voice/models/es_MX-claude-high.onnx
JARVIS_PIPER_LENGTH_SCALE=1.05
JARVIS_PIPER_NOISE_SCALE=0.55
JARVIS_PIPER_NOISE_W_SCALE=0.8
# To use the Fish Audio voice, provision fish-api-key through systemd credentials
# and set JARVIS_TTS_PROVIDER=fish. Never place the API key in this file.
JARVIS_TTS_PROVIDER=piper
JARVIS_FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe
JARVIS_FISH_MODEL=s2.1-pro-free
