# Managed JARVIS Core ingress. Included from Nginx Proxy Manager's HTTP context.

limit_req_zone $binary_remote_addr zone=jarvis_session:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=jarvis_voice:10m;

server {
    listen 80;
    listen [::]:80;
    server_name jarvis.d4rkn0d3.com;

    # Internal-only ingress. Block tunnel containers before allowing RFC1918 clients.
    deny 192.168.1.7;
    deny 192.168.1.117;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 127.0.0.0/8;
    deny all;

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name jarvis.d4rkn0d3.com;

    # Internal-only ingress. Block tunnel containers before allowing RFC1918 clients.
    deny 192.168.1.7;
    deny 192.168.1.117;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 127.0.0.0/8;
    deny all;

    ssl_certificate /etc/letsencrypt/live/npm-3/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/npm-3/privkey.pem;
    include /etc/nginx/conf.d/include/ssl-ciphers.conf;

    client_max_body_size 32k;
    include /etc/nginx/snippets/jarvis-security-headers.conf;

    access_log /data/logs/jarvis-core_access.log proxy;
    error_log /data/logs/jarvis-core_error.log warn;

    root /usr/share/jarvis/web;
    index index.html;

    location = /api/v1/session {
        limit_req zone=jarvis_session burst=3 nodelay;
        proxy_set_header Origin $http_origin;
        set $forward_scheme http;
        set $server "{{JARVIS_CORE_UPSTREAM}}";
        set $port 4100;
        include /etc/nginx/conf.d/include/proxy.conf;
    }

    # Keep the current Core contract same-origin during the web migration.
    location = /v1/health {
        set $forward_scheme http;
        set $server "{{JARVIS_CORE_UPSTREAM}}";
        set $port 4100;
        include /etc/nginx/conf.d/include/proxy.conf;
    }

    location = /v1/requests {
        set $forward_scheme http;
        set $server "{{JARVIS_CORE_UPSTREAM}}";
        set $port 4100;
        include /etc/nginx/conf.d/include/proxy.conf;
    }

    location ^~ /api/ {
        proxy_set_header Origin $http_origin;
        set $forward_scheme http;
        set $server "{{JARVIS_CORE_UPSTREAM}}";
        set $port 4100;
        include /etc/nginx/conf.d/include/proxy.conf;
    }

    location = /ws {
        proxy_pass http://{{JARVIS_CORE_UPSTREAM}}:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 75s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }

    location = /ws/voice {
        limit_conn jarvis_voice 1;
        proxy_pass http://{{JARVIS_CORE_UPSTREAM}}:4100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 130s;
        proxy_send_timeout 20s;
        proxy_buffering off;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        include /etc/nginx/snippets/jarvis-security-headers.conf;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/snippets/jarvis-security-headers.conf;
        add_header Cache-Control "no-store";
    }
}
