{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.example.internal/contracts/api/system-health.v1.schema.json",
  "title": "JARVIS aggregate system health v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "status", "state", "components"],
  "properties": {
    "api_version": { "const": "v1" },
    "status": { "enum": ["healthy", "degraded", "unavailable"] },
    "state": {
      "enum": [
        "IDLE", "LISTENING", "THINKING", "ROUTING", "EXECUTING",
        "SPEAKING", "AUTHORIZATION_REQUIRED", "WARNING", "ERROR", "OFFLINE"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "agent_status", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "enum": ["healthy", "degraded", "unavailable"] },
        "agent_status": {
          "enum": ["REALTIME", "READY", "BUSY", "DEGRADED", "ERROR", "OFFLINE"]
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "last_seen_ms": { "type": "integer", "minimum": 0 },
        "error": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
