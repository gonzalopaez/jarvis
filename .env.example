# Non-secret local development settings only.
# Transitional native Tauri client only. The Web UI uses same-origin routes and
# must never receive bearer credentials through Vite variables or JavaScript.
JARVIS_CORE_URL=https://jarvis.example.internal
JARVIS_CORE_TOKEN_FILE=/path/to/private/core-token

# Server-side exact browser origin used for WebSocket Origin validation.
JARVIS_WEB_ORIGIN=https://jarvis.example.internal
# Private server-to-server voice pipeline. Tokens are supplied with systemd credentials.
JARVIS_VOICE_URL=http://192.168.1.22:4200/
JARVIS_LITELLM_URL=http://192.168.1.11:4000/
JARVIS_LITELLM_MODEL=jarvis-fast
# Optional internal Codex expert service. Credentials are delivered through
# systemd LoadCredential as codex-service-token; never place a token here.
JARVIS_CODEX_URL=http://127.0.0.1:4400/
JARVIS_CODEX_TASK_TIMEOUT_SECONDS=120
